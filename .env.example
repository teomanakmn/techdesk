# Supabase bağlantı bilgileri
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin:
#   cp .env.example .env
#
# Değerler Supabase Dashboard → Settings → API bölümünden alınır.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Admin API için gerekli (Kullanıcı Yönetimi modülü)
# Supabase Dashboard → Settings → API → service_role key
# ⚠️ Bu key'i ASLA public ortamda paylaşmayın!
VITE_SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
